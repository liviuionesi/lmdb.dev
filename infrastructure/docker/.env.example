# LMDB Microservices - Docker Compose Environment Variables
# Copy this file to .env and customize the values

# =============================================================================
# PostgreSQL Configuration
# =============================================================================
POSTGRES_DB=lmdb
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin123
POSTGRES_PORT=5432

# Multiple databases created on initialization
# Used by User Service and Actor Service

# =============================================================================
# MongoDB Configuration
# =============================================================================
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=admin123
MONGO_DATABASE=lmdb
MONGO_PORT=27017

# Used by Movie Service, AI Service, and Media Service

# =============================================================================
# Redis Configuration
# =============================================================================
REDIS_PASSWORD=redis123
REDIS_PORT=6379

# Used by API Gateway for rate limiting and session management

# =============================================================================
# JWT Authentication Configuration
# =============================================================================
JWT_SECRET=lmdb-secret-key-change-in-production

# =============================================================================
# MinIO Configuration (Object Storage)
# =============================================================================
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Used by Media Service for storing images, videos, etc.

# =============================================================================
# Management UI Ports (Optional - can be disabled in docker-compose.yml)
# =============================================================================

# Adminer - PostgreSQL Web UI
# Access: http://localhost:9081
# System: PostgreSQL
# Server: postgres
# Username: admin (POSTGRES_USER)
# Password: admin123 (POSTGRES_PASSWORD)
# Database: lmdb (POSTGRES_DB)
# NOTE: Changed from 8081 to avoid conflict with Movie Service (8081)
ADMINER_PORT=9081

# Mongo Express - MongoDB Web UI
# Access: http://localhost:9082
# NOTE: Changed from 8082 to avoid conflict with User Service (8082)
MONGO_EXPRESS_PORT=9082

# Redis Commander - Redis Web UI
# Access: http://localhost:9083
# NOTE: Changed from 8083 to avoid conflict with Actor Service (8083)
REDIS_COMMANDER_PORT=9083

# =============================================================================
# Service Ports (for when services are containerized)
# =============================================================================

# Infrastructure Services
DISCOVERY_SERVICE_PORT=8761
CONFIG_SERVICE_PORT=8888
# Address the services use to reach the config server. compose sets this
# for each service; leave it unset for a bare-JVM run against localhost.
CONFIG_SERVER_URL=http://config-service:8888
API_GATEWAY_PORT=8080

# Domain Services
MOVIE_SERVICE_PORT=8081
USER_SERVICE_PORT=8082
ACTOR_SERVICE_PORT=8083
AI_SERVICE_PORT=8084
MEDIA_SERVICE_PORT=8085

# Shared token every caller of ai-service's gRPC surface must present as the
# `x-service-token` metadata header. That port is not published to the host and
# api-gateway's JWT chain never sits in front of it, so this token is the only
# thing authenticating gRPC callers. Leaving it unset is safe: ai-service then
# rejects every RPC rather than accepting unauthenticated ones. Generate one
# with `openssl rand -hex 32` and never reuse the value across environments.
AI_SERVICE_GRPC_TOKEN=change-me-generate-with-openssl-rand-hex-32

# =============================================================================
# Local ELK Stack (docker-compose.elk.yml, issue #24)
# =============================================================================
# Access: http://localhost:5601 (Kibana), http://localhost:9200 (Elasticsearch)
ELASTICSEARCH_PORT=9200
KIBANA_PORT=5601
# At-rest encryption key for Kibana's actions/alerting saved objects (Lens
# dashboards suite, issue #71). Local dev only - no external creds behind it.
KIBANA_ENCRYPTION_KEY=a-local-dev-only-encryption-key-32chars

# =============================================================================
# TMDB API Configuration
# =============================================================================
# Required by movie-service/actor-service (catalog population) and
# api-gateway (auth/account proxy, issue #33). Get a free key at
# https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# Optional: a real TMDB account's credentials, used only to let the Postman
# collection's auth/account folder approve its own request token without a
# browser step (closes issue #33 AC2/AC3). Leave blank if you don't need
# that automation — nothing else reads these.
TMDB_USERNAME=
TMDB_PASSWORD=

# =============================================================================
# Development Notes
# =============================================================================

# 1. Start infrastructure:
#    cd infrastructure/docker
#    docker-compose up -d
#
# 2. Check status:
#    docker-compose ps
#
# 3. View logs:
#    docker-compose logs -f [service-name]
#
# 4. Stop infrastructure:
#    docker-compose down
#
# 5. Stop and remove volumes (CAUTION - deletes data):
#    docker-compose down -v
#
# 6. Access Management UIs:
#    - Adminer (PostgreSQL):    http://localhost:9081
#    - Mongo Express (MongoDB):  http://localhost:9082
#    - Redis Commander (Redis):  http://localhost:9083
#    - MinIO Console:            http://localhost:9001

# =============================================================================
# Connection Strings for Services
# =============================================================================

# PostgreSQL (Spring Boot)
# spring.datasource.url=jdbc:postgresql://localhost:5432/lmdb
# spring.datasource.username=admin
# spring.datasource.password=admin123

# MongoDB (Spring Boot)
# spring.data.mongodb.uri=mongodb://admin:admin123@localhost:27017/lmdb?authSource=admin

# Redis (Spring Boot)
# spring.data.redis.host=localhost
# spring.data.redis.port=6379
# spring.data.redis.password=redis123

# MinIO (Spring Boot with MinIO SDK)
# minio.url=http://localhost:9000
# minio.access-key=minioadmin
# minio.secret-key=minioadmin123

