{
  "index_patterns": ["filmpire-logs-*"],
  "template": {
    "settings": {
      "number_of_shards": 1,
      "number_of_replicas": 0,
      "index.lifecycle.name": "filmpire-logs-policy"
    },
    "mappings": {
      "properties": {
        "@timestamp": { "type": "date" },
        "application": { "type": "keyword" },
        "level": { "type": "keyword" },
        "level_value": { "type": "integer" },
        "logger_name": { "type": "keyword" },
        "thread_name": { "type": "keyword" },
        "message": { "type": "text" },
        "traceId": { "type": "keyword" },
        "spanId": { "type": "keyword" },
        "stack_trace": { "type": "text" }
      }
    }
  },
  "_meta": {
    "description": "Filmpire service logs, ARCHITECTURE.md section 12.2 (issue #24)",
    "managed_by": "infrastructure/docker/elk/setup/setup.sh"
  }
}
