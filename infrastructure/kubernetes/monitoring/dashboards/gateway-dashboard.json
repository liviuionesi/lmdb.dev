{
  "title": "LMDB - API Gateway",
  "uid": "lmdb-gateway",
  "tags": ["lmdb"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": { "text": "Prometheus", "value": "Prometheus" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Route latency (P95) by route",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(spring_cloud_gateway_requests_seconds_bucket{application=\"api-gateway\"}[5m])) by (le, routeId))",
          "legendFormat": "{{routeId}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Route request rate by outcome",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum(rate(spring_cloud_gateway_requests_seconds_count{application=\"api-gateway\"}[5m])) by (routeId, outcome)",
          "legendFormat": "{{routeId}} {{outcome}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Rate-limit rejections (HTTP 429/s)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{application=\"api-gateway\", status=\"429\"}[5m])) by (uri)",
          "legendFormat": "{{uri}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "Circuit breaker state (1 = active)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0, "max": 1 }, "overrides": [] },
      "targets": [
        {
          "expr": "resilience4j_circuitbreaker_state{application=\"api-gateway\", state=\"open\"}",
          "legendFormat": "{{name}} OPEN"
        },
        {
          "expr": "resilience4j_circuitbreaker_state{application=\"api-gateway\", state=\"half_open\"}",
          "legendFormat": "{{name}} HALF_OPEN"
        }
      ]
    }
  ]
}
