# Copy to secrets.env (gitignored) and fill in real values before applying
# this overlay. See overlays/azure/secrets.env.example for the same notes —
# both cloud overlays use an identical full-parity secret shape (#151).

POSTGRES_USER=admin
POSTGRES_PASSWORD=CHANGE_ME

MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=CHANGE_ME
MONGODB_URI=mongodb://admin:CHANGE_ME@mongodb:27017/lmdb?authSource=admin

REDIS_PASSWORD=CHANGE_ME

JWT_SECRET=CHANGE_ME

# Required — get one at https://www.themoviedb.org/settings/api.
TMDB_API_KEY=
