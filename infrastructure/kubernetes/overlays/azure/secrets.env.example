# Copy to secrets.env (gitignored) and fill in real values before applying
# this overlay. On a real deploy these normally come from Terraform outputs
# / a secret manager rather than a hand-filled file (ARCHITECTURE.md §11.3:
# "created out-of-band by Terraform — never plaintext in the repo") — this
# template exists for the manual/demo path (`kubectl apply -k`) described in
# the same section, and for local `kustomize build` validation.
#
# Full local-parity service set (#151) — includes Postgres now that
# user-service/actor-service/ai-service are deployed here too.

POSTGRES_USER=admin
POSTGRES_PASSWORD=CHANGE_ME

MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=CHANGE_ME
MONGODB_URI=mongodb://admin:CHANGE_ME@mongodb:27017/filmpire?authSource=admin

REDIS_PASSWORD=CHANGE_ME

# CONTRACT: shared HS256 secret — api-gateway validates the tokens
# user-service issues. Any value works as long as both read the same key,
# which they do (both from filmpire-secrets).
JWT_SECRET=CHANGE_ME

# Required — get one at https://www.themoviedb.org/settings/api.
TMDB_API_KEY=
