# Copy to secrets.env (gitignored) and fill in real values before applying
# this overlay:
#
#   cp secrets.env.example secrets.env
#   kubectl apply -k infrastructure/kubernetes/overlays/local
#
# Defaults below match infrastructure/docker/env.example — safe, well-known
# local-only credentials, NOT meant for anything internet-reachable.

POSTGRES_USER=admin
POSTGRES_PASSWORD=<your-postgres-password>

MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=<your-mongo-password>
# Must stay consistent with MONGO_ROOT_USER/MONGO_ROOT_PASSWORD above —
# Kustomize secretGenerator has no way to compose a URI from other keys, so
# this is a second copy of the same credentials in Spring's connection-string
# form (spring.mongodb.uri).
MONGODB_URI=mongodb://admin:<your-mongo-password>@mongodb:27017/lmdb?authSource=admin

REDIS_PASSWORD=<your-redis-password>

# CONTRACT: shared HS256 secret — api-gateway validates the tokens
# user-service issues. Any value works locally as long as both read the
# same key, which they do (both from lmdb-secrets).
JWT_SECRET=<your-jwt-secret-key>

# Required — get one at https://www.themoviedb.org/settings/api. The gateway
# crash-loops on route refresh without it (AddRequestParameter rejects an
# empty value at bind time).
TMDB_API_KEY=
