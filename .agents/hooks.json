{
  "graphify-guard": {
    "PreToolUse": [
      {
        "matcher": "run_command|grep_search",
        "hooks": [
          {
            "type": "command",
            "command": "./hooks/graphify-guard.py search",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "view_file|find_by_name|list_dir",
        "hooks": [
          {
            "type": "command",
            "command": "./hooks/graphify-guard.py read",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
