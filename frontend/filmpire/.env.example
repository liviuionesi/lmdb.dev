VITE_TMDB_KEY=
# Optional: point at a local filmpire-microservices gateway instead of the
# real TMDB API. Falls back to https://api.themoviedb.org/3 when unset.
# VITE_API_URL=http://localhost:8080

# Backend Target Provider: azure | aws | minikube
# Sets the default cloud/local backend target for on-demand wake-up and routing.
# VITE_BACKEND_TARGET=azure

# Standby Pre-Show Trailer (YouTube video ID or URL, defaults to h2QJMfXJZaY - Dune 2)
# VITE_STANDBY_TRAILER_ID=h2QJMfXJZaY

# Admin dashboard (/admin) links — all optional, default to local docker-compose ports.
# VITE_DISCOVERY_URL=http://localhost:8761
# VITE_KIBANA_URL=http://localhost:5601
# Only set this when deployed against minikube/k8s, where Grafana actually runs.
# VITE_GRAFANA_URL=