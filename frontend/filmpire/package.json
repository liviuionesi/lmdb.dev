{
  "name": "filmpire_jsm",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@emotion/react": "^11.4.1",
    "@emotion/styled": "^11.3.0",
    "@mui/icons-material": "^5.0.3",
    "@mui/material": "^5.15.18",
    "@mui/styles": "^5.15.18",
    "@reduxjs/toolkit": "^1.6.2",
    "@testing-library/jest-dom": "^5.11.4",
    "@testing-library/react": "^11.1.0",
    "@testing-library/user-event": "^12.1.10",
    "axios": "^1.6.8",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-redux": "^7.2.5",
    "react-router-dom": "^5.3.0",
    "react-scripts": "5.0.1",
    "web-vitals": "^6.0.1"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "lint": "NODE_ENV=development eslint src --ext .js,.jsx",
    "deps:check": "ncu",
    "deps:update": "ncu -u && npm install",
    "codemod": "codemod",
    "codemod:react18": "codemod react/18/migration-recipe",
    "codemod:mui": "npx @mui/codemod v5.0.0/preset-safe ./src"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ],
    "parserOptions": {
      "requireConfigFile": false,
      "babelOptions": {
        "presets": [
          "babel-preset-react-app"
        ]
      }
    }
  },
  "jest": {
    "collectCoverageFrom": [
      "src/**/*.{js,jsx}",
      "!src/**/*.test.{js,jsx}",
      "!src/setupTests.js",
      "!src/test-utils/**",
      "!src/index.js",
      "!src/app/store.js",
      "!src/assets/**",
      "!src/components/index.js",
      "!src/components/styles.js",
      "!src/components/App.jsx"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@babel/eslint-parser": "^7.24.5",
    "@babel/plugin-proposal-private-property-in-object": "^7.21.11",
    "@codemod/cli": "^3.3.0",
    "eslint": "^7.32.0",
    "eslint-config-airbnb": "^18.2.1",
    "eslint-plugin-import": "^2.24.2",
    "eslint-plugin-jsx-a11y": "^6.4.1",
    "eslint-plugin-react": "^7.26.1",
    "eslint-plugin-react-hooks": "^4.2.0",
    "npm-check-updates": "^23.0.0"
  },
  "overrides": {
    "nth-check": "2.1.1",
    "svgo": "2.8.3",
    "serialize-javascript": "7.0.7",
    "underscore": "1.13.8",
    "postcss": "8.5.25"
  }
}
