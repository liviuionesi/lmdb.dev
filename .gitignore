.idea/
*.iws
*.iml
*.ipr
out/
!**/src/main/**/out/
!**/src/test/**/out/

# Eclipse
.classpath
.project
.settings/
bin/
!**/src/main/**/bin/
!**/src/test/**/bin/

# VS Code
.vscode/*
!.vscode/settings.json

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Next.js
.next/
out/
dist/

# React Native / Expo
.expo/
.expo-shared/
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*
web-build/

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Kustomize secretGenerator inputs (#25) — real credentials, never commit.
# Keep the checked-in secrets.env.example templates.
infrastructure/kubernetes/**/secrets.env

# Logs
logs/
*.log

# OS
.DS_Store
Thumbs.db

# Docker
*.pid
*.seed
*.pid.lock

# Test coverage
coverage/
.nyc_output/

# Temporary files
*.tmp
*.temp
*.swp
*.swo
*~


# newman smoke-test report (issue #47)
newman-report.xml

# Terraform (#26/#27) — state and account-specific/secret inputs never
# committed. .terraform.lock.hcl IS meant to be committed (provider
# version pinning) — do not add it here.
infrastructure/terraform/**/.terraform/
infrastructure/terraform/**/*.tfstate
infrastructure/terraform/**/*.tfstate.*
infrastructure/terraform/**/crash.log
infrastructure/terraform/**/crash.*.log
infrastructure/terraform/**/*.tfvars
!infrastructure/terraform/**/*.tfvars.example
infrastructure/terraform/**/backend.hcl
infrastructure/terraform/**/tfplan
infrastructure/terraform/**/kubeconfig-*.yaml
infrastructure/terraform/**/override.tf
infrastructure/terraform/**/override.tf.json
infrastructure/terraform/**/*_override.tf
infrastructure/terraform/**/*_override.tf.json
