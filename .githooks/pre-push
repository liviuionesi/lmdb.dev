#!/bin/sh
# Automatically regenerates docs/PROJECT_METRICS.md before git push
set -eu

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

if command -v python3 >/dev/null 2>&1 && [ -f "./infrastructure/scripts/generate-project-stats.py" ]; then
  echo "pre-push: Refreshing dynamic project statistics and metrics report..."
  python3 ./infrastructure/scripts/generate-project-stats.py >/dev/null 2>&1 || true
fi

exit 0
