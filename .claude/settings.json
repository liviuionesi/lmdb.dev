{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c '\"${CLAUDE_PROJECT_DIR:-.}\"/.claude/hooks/graphify-guard.sh search'"
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c '\"${CLAUDE_PROJECT_DIR:-.}\"/.claude/hooks/graphify-guard.sh read'"
          }
        ]
      }
    ]
  }
}
